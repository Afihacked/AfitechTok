<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Gambar QRIS -->
        <ImageView
            android:id="@+id/iv_qris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/qris"
            android:src="@drawable/qris_image" />

        <!-- Garis pembatas opsional -->
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?android:attr/textColorSecondary" />

        <!-- Keterangan di bawah gambar -->
        <TextView
            android:id="@+id/tv_qris_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/qris_instructions"
            android:textSize="14sp"
            android:padding="4dp"
            android:textColor="?android:attr/textColorPrimary" />

    </LinearLayout>
</ScrollView>
