<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ================= APP BAR ================= -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            app:popupTheme="@style/ThemeOverlay.Material3.Light"/>

    </com.google.android.material.appbar.AppBarLayout>


    <!-- ================= MAIN CONTENT ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/tab_container"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/extra_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- BOTTOM NAV (TETAP) -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:elevation="12dp"
        android:background="@drawable/bg_glass_shadow">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNavCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/glass_surface"
            app:cardCornerRadius="34dp"
            app:strokeColor="@color/glass_stroke"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                <!-- CONTENT LAYER (NO BLUR) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:elevation="6dp"
                    android:gravity="center">

                    <!-- ITEM TEMPLATE -->
                    <!-- TikTok -->
                    <FrameLayout
                        android:id="@+id/navTikTok"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/navTikTokInner"
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="6dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="8dp"
                            android:background="@null">

                            <ImageView
                                android:id="@+id/iconTikTok"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_tiktok_outline"/>

                            <TextView
                                android:id="@+id/textTikTok"
                                android:text="TikTok"
                                android:textSize="11sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"/>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- WhatsApp -->
                    <FrameLayout
                        android:id="@+id/navWhatsApp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/navWhatsAppInner"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="6dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp"
                        android:background="@null">

                        <ImageView
                            android:id="@+id/iconWhatsApp"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_wa_outline"/>

                        <TextView
                            android:id="@+id/textWhatsApp"
                            android:text="WhatsApp"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"/>
                    </LinearLayout>
                    </FrameLayout>

                    <!-- History -->
                    <FrameLayout
                        android:id="@+id/navHistory"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/navHistoryInner"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="6dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp"
                        android:background="@null">

                        <ImageView
                            android:id="@+id/iconHistory"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_folder_outline"/>

                        <TextView
                            android:id="@+id/textHistory"
                            android:text="Riwayat"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"/>
                    </LinearLayout>
                    </FrameLayout>

                    <!-- Settings -->
                    <FrameLayout
                        android:id="@+id/navSettings"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/navSettingsInner"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="6dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="8dp"
                        android:background="@null">

                        <ImageView
                            android:id="@+id/iconSettings"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_settings_glass"/>

                        <TextView
                            android:id="@+id/textSettings"
                            android:text="Pengaturan"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"/>
                    </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
