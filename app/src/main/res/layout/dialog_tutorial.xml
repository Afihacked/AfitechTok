<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tutorial_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Judul -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BAGAIMANA CARA UNDUH DARI TIKTOK ?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Klik Ikon Tiktok Untuk Membuka Aplikasi Tiktok"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorOnSurface" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/step1_tt"
                android:contentDescription="@string/step1" />
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Cari Video yang Ingin di Unduh, Kemudian Klik Ikon Bagikan"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorOnSurface" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/step3"
                android:contentDescription="@string/step2" />
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Kemudian Pilih Salin Tautan. Buka Kembali Aplikasi Sosmed Toolkit"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorOnSurface" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/step4"
                android:contentDescription="@string/step3" />
        </LinearLayout>

        <!-- Step 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Jika Aplikasi Tidak Menempel Tautan Otomatis Klik Tombol Tempel, Kemudian Klik Unduh."
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorOnSurface" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/step2_tt"
                android:contentDescription="@string/step4" />
        </LinearLayout>

        <!-- Step 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Jika Tautan Berupa Video Maka Akan Muncul Dua Pilihan Videos atau Music dan Ketika Tautan Berisi Gambar Maka Akan Muncul Halaman Untuk Memilih Foto Yang Ingin Diunduh."
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorOnSurface" />
        </LinearLayout>

        <!-- Akhir -->
        <View android:layout_width="match_parent" android:layout_height="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip: Gunakan tombol Paste jika link tidak otomatis muncul dari clipboard."
            android:textColor="@color/colorOutline"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOk"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/ok"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:background="@android:color/transparent"
                app:rippleColor="@color/colorPrimary"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
