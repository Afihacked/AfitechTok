<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================================================== -->
    <!-- BASE THEME (APP-WIDE)                                 -->
    <!-- ===================================================== -->
    <style name="Base.Theme.TikDownloader"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="toolbarStyle">@style/CustomToolbar</item>
        <!-- SYSTEM BARS -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- MATERIAL COLORS -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>

        <item name="colorOutline">@color/colorOutline</item>

    </style>
    <style name="CustomToolbar"
        parent="Widget.Material3.Toolbar">

        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>

    </style>
    <!-- ===================================================== -->
    <!-- APP THEME                                            -->
    <!-- ===================================================== -->
    <style name="Theme.TikDownloader"
        parent="Base.Theme.TikDownloader" />

    <!-- ===================================================== -->
    <!-- SPLASH THEME                                         -->
    <!-- ===================================================== -->
    <style name="Theme.Splash"
        parent="Theme.Material3.DayNight.NoActionBar">
        <!-- MATERIAL COLORS -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>

        <item name="colorOutline">@color/colorOutline</item>

        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

    </style>

    <!-- ===================================================== -->
    <!-- POPUP MENU                                           -->
    <!-- ===================================================== -->
    <style name="PopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <style name="PopupMenuThemeOverlay">
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
    </style>

    <!-- ===================================================== -->
    <!-- SPINNER                                              -->
    <!-- ===================================================== -->
    <style name="MySpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_spinner_dropdown</item>
    </style>

    <!-- ===================================================== -->
    <!-- TEXTINPUT STYLE                                      -->
    <!-- ===================================================== -->
    <style name="EditTextTheme"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxBackgroundColor">?attr/colorSurface</item>

        <!-- Jangan set boxStrokeColor manual -->

        <item name="hintTextColor">?attr/colorOnSurface</item>

        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

    </style>

    <!-- ===================================================== -->
    <!-- DIALOG                                               -->
    <!-- ===================================================== -->
    <style name="ThemeOverlay.TikDownloader.MaterialAlertDialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog" />

</resources>