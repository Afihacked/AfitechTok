<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================================================== -->
    <!-- BASE THEME (APP-WIDE)                                 -->
    <!-- ===================================================== -->
    <style name="Base.Theme.TikDownloader"
        parent="Theme.Material3.Light.NoActionBar">
<!--        <item name="android:forceDarkAllowed">false</item>-->
        <!-- Surface colors -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>

        <!-- Primary -->
        <item name="colorPrimary">@color/colorPrimary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/colorSurface</item>

    </style>

    <!-- ===================================================== -->
    <!-- APP THEME                                            -->
    <!-- ===================================================== -->
    <style name="Theme.TikDownloader"
        parent="Base.Theme.TikDownloader" />

    <!-- ===================================================== -->
    <!-- SPLASH THEME                                         -->
    <!-- ===================================================== -->
    <style name="Theme.Splash"
        parent="Theme.Material3.Light.NoActionBar">

        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/sttsbar</item>
        <item name="android:navigationBarColor">@color/navigationBarColor</item>

    </style>

    <!-- ===================================================== -->
    <!-- POPUP MENU                                           -->
    <!-- ===================================================== -->
    <style name="PopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- 🔥 INI YANG SERING TERLEWAT -->
    <style name="PopupMenuThemeOverlay">
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
    </style>

<!--    SPINNER-->
    <style name="MySpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_spinner_dropdown</item>
    </style>

    <!-- ===================================================== -->
    <!-- TEXTINPUT / EDITTEXT STYLE                            -->
    <!-- ===================================================== -->
    <!-- Dipakai sebagai style di layout -->
    <style name="EditTextTheme"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <!-- Text -->
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textColorHint">@color/colorHint</item>

        <!-- Box -->
        <item name="boxBackgroundColor">@color/colorSurface</item>
<!--        <item name="boxStrokeColor">@color/colorOutline</item>-->
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

        <!-- Hint -->
        <item name="hintTextColor">@color/colorHint</item>

    </style>

    <!-- ===================================================== -->
    <!-- DIALOG                                               -->
    <!-- ===================================================== -->
    <style name="ThemeOverlay.TikDownloader.MaterialAlertDialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
    </style>

</resources>
